# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/mini_operations_erp
# Neon:    postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/mini_operations_erp?sslmode=require
# Railway: postgresql://user:password@host.railway.app:PORT/mini_operations_erp
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/mini_operations_erp

# JWT secret — use a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-production-secret

# Server port
PORT=5000

# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# Dedicated test database (must be isolated from dev)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/mini_operations_test
