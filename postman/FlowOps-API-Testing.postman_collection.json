          "name": "Test 4 - Same Transfer Cannot Be Received Twice",
          "item": [
            {
              "name": "4.1 Receive Transfer Again",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status code is 400 or 409', function () { pm.expect(pm.response.code).to.be.oneOf([400, 409]); });",
                      "pm.test('Error message indicates cannot receive or already processed', function () {",
                      "  var data = pm.response.json();",
                      "  pm.expect(data.error).to.match(/Cannot receive transfer with status RECEIVED|Transfer receipt has already been processed/);",
                      "});"
                    ],
                    "type": "text/javascript"
