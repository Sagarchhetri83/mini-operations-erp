                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Sales User login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('salesToken', data.token);"
