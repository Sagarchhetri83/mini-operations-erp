                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Fetch Inventory Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "var mainWH = data.find(i => i.location.code === 'WH-MAIN').locationId;",
                  "var branchWH = data.find(i => i.location.code === 'WH-BRANCH').locationId;",
                  "pm.collectionVariables.set('mainWarehouseId', mainWH);",
                  "pm.collectionVariables.set('branchWarehouseId', branchWH);",
                  "",
                  "var invSteel = data.find(i => i.item.sku === 'STL-ROD-6M' && i.location.code === 'WH-MAIN');",
                  "if (invSteel) {",
                  "  pm.collectionVariables.set('invSteelMainId', invSteel.id);",
                  "  pm.collectionVariables.set('itemSteelId', invSteel.itemId);",
                  "}",
                  "",
                  "var invWidgetBranch = data.find(i => i.item.sku === 'WDG-A100' && i.location.code === 'WH-BRANCH' && i.batch === 'BATCH-2026-A');",
                  "if (invWidgetBranch) {",
                  "  pm.collectionVariables.set('invWidgetBranchAId', invWidgetBranch.id);",
                  "  pm.collectionVariables.set('itemWidgetId', invWidgetBranch.itemId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operationsToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Mandatory Tests",
      "item": [
        {
          "name": "Test 1 - Cannot Reserve More Than Available",
          "item": [
            {
              "name": "1.1 GET Inventory Before",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                      "var data = pm.response.json();",
                      "pm.collectionVariables.set('beforeReservedQty', data.reservedQty);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/{{invSteelMainId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "{{invSteelMainId}}"
                  ]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{salesToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "1.2 Create Order (DRAFT)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                      "var data = pm.response.json();",
                      "pm.collectionVariables.set('draftOrderId', data.id);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"customerId\":\"seed-cust-1\",\"items\":[{\"inventoryId\":\"{{invSteelMainId}}\",\"itemId\":\"{{itemSteelId}}\",\"quantity\":9999}]}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/orders",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "orders"
                  ]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{salesToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "1.3 Confirm Order (Fails)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                      "pm.test('Error message indicates insufficient stock', function () {",
                      "  var data = pm.response.json();",
                      "  pm.expect(data.error).to.include('Insufficient stock');",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/orders/{{draftOrderId}}/confirm",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "orders",
                    "{{draftOrderId}}",
                    "confirm"
                  ]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{salesToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "1.4 GET Inventory After",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                      "pm.test('Reserved quantity remains unchanged', function () {",
                      "  var data = pm.response.json();",
                      "  var before = pm.collectionVariables.get('beforeReservedQty');",
                      "  pm.expect(data.reservedQty).to.eql(before);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/{{invSteelMainId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "{{invSteelMainId}}"
                  ]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{salesToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        },
